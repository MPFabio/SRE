{
  "name": "Reskilling SRE",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/SRE",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "forwardPorts": [3000, 4317, 8080, 8081, 8082, 8083, 8084, 8085, 8089, 8090, 8889, 9090, 9093],

  "portsAttributes": {
    "3000": { "label": "Grafana", "onAutoForward": "notify" },
    "4317": { "label": "OTLP gRPC", "onAutoForward": "silent" },
    "8080": { "label": "Boutique CapShop", "onAutoForward": "openBrowser" },
    "8081": { "label": "Catalog Service", "onAutoForward": "silent" },
    "8082": { "label": "Cart Service", "onAutoForward": "silent" },
    "8083": { "label": "Orders Service", "onAutoForward": "silent" },
    "8084": { "label": "Payment Service", "onAutoForward": "silent" },
    "8085": { "label": "Users Service", "onAutoForward": "silent" },
    "8089": { "label": "Locust", "onAutoForward": "notify" },
    "8090": { "label": "Operations Console", "onAutoForward": "openBrowser" },
    "8889": { "label": "OTel Collector metrics", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" },
    "9093": { "label": "Alertmanager", "onAutoForward": "silent" }
  },

  "postCreateCommand": "make help",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  }
}
